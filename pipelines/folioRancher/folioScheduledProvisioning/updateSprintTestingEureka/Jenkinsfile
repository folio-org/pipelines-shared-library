#!groovy
import groovy.transform.Field
import org.folio.Constants
import org.folio.models.parameters.CreateNamespaceParameters
import org.folio.rest_v2.PlatformType
import org.jenkinsci.plugins.workflow.libs.Library

import java.time.DayOfWeek
import java.time.LocalDate
import java.time.temporal.TemporalAdjusters

@Library('pipelines-shared-library') _

@Field final String createNamespaceJobName = Constants.JENKINS_CREATE_NAMESPACE_FROM_BRANCH_JOB
@Field final String deleteNamespaceJobName = Constants.JENKINS_DELETE_NAMESPACE_JOB

@Field final LocalDate today = LocalDate.now()

// Sprint schedule of the RANCHER project (Eureka Scrum Board). Sprints start on Monday and last 2 weeks;
// Sprint 257 is 3 weeks long (winter holidays). Extend the list when new sprints are planned -
// the regular 2-week cadence is extrapolated for sprints beyond the list.
@Field final List<LocalDate> sprintStartDates = [
  LocalDate.of(2026, 11, 9),  // Sprint 254
  LocalDate.of(2026, 11, 23), // Sprint 255
  LocalDate.of(2026, 12, 7),  // Sprint 256
  LocalDate.of(2026, 12, 21), // Sprint 257
  LocalDate.of(2027, 1, 11)   // Sprint 258
]
@Field final int sprintLengthDays = 14

LocalDate sprintStart
for (int i = 0; i < sprintStartDates.size(); i++) {
  LocalDate intervalEnd = (i + 1 < sprintStartDates.size()) ?
    sprintStartDates[i + 1] : sprintStartDates[i].plusDays(sprintLengthDays)
  if (!today.isBefore(sprintStartDates[i]) && today.isBefore(intervalEnd)) {
    sprintStart = sprintStartDates[i]
    break
  }
}
if (sprintStart == null) {
  sprintStart = sprintStartDates.last()
  while (!today.isBefore(sprintStart.plusDays(sprintLengthDays))) {
    sprintStart = sprintStart.plusDays(sprintLengthDays)
  }
}

// Full rebuild runs on the first Wednesday of the sprint, daily updates run on all other days
LocalDate sprintRebuildDay = sprintStart.with(TemporalAdjusters.nextOrSame(DayOfWeek.WEDNESDAY))
boolean isSprintRebuildDay = today == sprintRebuildDay

properties([
  buildDiscarder(logRotator(numToKeepStr: '30')),
  disableConcurrentBuilds(),
  parameters([
    folioParameters.platform(),
    folioParameters.cluster('PLATFORM'),
    folioParameters.namespace(),
    folioParameters.configType(),
    string(name: 'DB_BACKUP_NAME', defaultValue: 'folio-bugfest-trillium-16-06-2026-ga', description: 'Set DB backup name'),
    booleanParam(name: 'MARC_MIGRATIONS', defaultValue: false, description: 'enable marc-migrations'),
    choice(name: 'TYPE', choices: ['full', 'terraform', 'update'], description: '(Required) Set action TYPE to perform'),
    booleanParam(name: 'IS_CRON_JOB', defaultValue: false, description: '(Hidden) Is job triggered by cron job'),
    folioParameters.refreshParameters()
    , folioParameters.hideParameters(['IS_CRON_JOB'])

  ]),
  pipelineTriggers([
    parameterizedCron('''
      H 3 * * 1,2,3,4,5 %PLATFORM=EUREKA;CLUSTER=folio-etesting;NAMESPACE=sprint;CONFIG_TYPE=testing;DB_BACKUP_NAME=folio-bugfest-trillium-16-06-2026-ga;MARC_MIGRATIONS=true;TYPE=update;IS_CRON_JOB=true
      H 0 * * 3 %PLATFORM=EUREKA;CLUSTER=folio-etesting;NAMESPACE=sprint;CONFIG_TYPE=testing;DB_BACKUP_NAME=folio-bugfest-trillium-16-06-2026-ga;MARC_MIGRATIONS=true;TYPE=full;IS_CRON_JOB=true
    ''')])
])


if (params.REFRESH_PARAMETERS) {
  currentBuild.result = 'ABORTED'
  return
}

if (params.CONFIG_TYPE == 'release') {
  folioCommon.kitfoxApproval()
}

if (params.IS_CRON_JOB) {
  if (isSprintRebuildDay && params.TYPE != 'full') {
    echo "REASON: Sprint ${sprintStart} first-week rebuild day ${sprintRebuildDay} but TYPE is '${params.TYPE}' (expected 'full')"
    currentBuild.result = 'ABORTED'
    return
  } else if (!isSprintRebuildDay && params.TYPE != 'update') {
    echo "REASON: ${today} is not the sprint rebuild day ${sprintRebuildDay} (sprint started ${sprintStart}) but TYPE is '${params.TYPE}' (expected 'update')"
    currentBuild.result = 'ABORTED'
    return
  }
  echo "Proceeding with execution - sprint ${sprintStart}, rebuild day ${sprintRebuildDay}, TYPE '${params.TYPE}'"
}

CreateNamespaceParameters namespace = new CreateNamespaceParameters.Builder()
  .clusterName(params.CLUSTER)
  .namespaceName(params.NAMESPACE)
  .platformBranch('snapshot')
  .configType(params.CONFIG_TYPE)
  .loadReference(false)
  .loadSample(false)
  .splitFiles(true)
  .dbBackupName(params.DB_BACKUP_NAME)
  .doMarcMigrations(params.MARC_MIGRATIONS)
  .type(params.TYPE)
  .hasSecureTenant(false)
  .uiBuild(false)
  .build(this)

ansiColor('xterm') {
  stage('Filter Applications') {
    if (!params.MARC_MIGRATIONS) {
      namespace.applications = namespace.applications.findAll { it != 'app-marc-migrations' }
    }
  }

  stage('Update Sprint Testing') {
    if(params.TYPE == 'full' ) {
      folioTriggerJob.deleteNamespace(deleteNamespaceJobName, namespace)
    }

    folioTriggerJob.createNamespaceFromBranch(createNamespaceJobName, namespace)
  }
}
